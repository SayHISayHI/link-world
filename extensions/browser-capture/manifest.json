{
  "manifest_version": 3,
  "name": "Link World Capture",
  "version": "0.1.0",
  "description": "Save the current page to the local Link World desktop app.",
  "action": {
    "default_title": "Save to Link World",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:17321/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ]
}
