{
  "manifest_version": 3,
  "name": "拾海 · Node Tide Capture",
  "version": "0.3.0",
  "description": "Save the current page to the local Node Tide desktop app.",
  "action": {
    "default_title": "Save to Node Tide",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:17321/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ]
}
